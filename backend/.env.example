APP_NAME="LMS Capstone"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lms_capstone
DB_USERNAME=postgres
DB_PASSWORD=

# --- Session & Sanctum (SPA first-party, cookie) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# URL frontend (untuk CORS) dan domain yang dianggap "stateful" oleh Sanctum.
# Gunakan host yang sama dengan yang dibuka di browser (localhost ATAU 127.0.0.1, jangan dicampur).
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Admin awal (opsional, dipakai oleh `php artisan db:seed`) ---
# Jika ADMIN_EMAIL dan ADMIN_PASSWORD (min. 12 karakter) diisi, seeder akan membuat akun Admin.
# Alternatif yang lebih aman: kosongkan keduanya, lalu jalankan `php artisan lms:create-admin`.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opsional, khusus development: password untuk akun contoh dari `php artisan db:seed --class=DemoUserSeeder`.
# Min. 12 karakter, ada huruf dan angka. Jika kosong, password acak dibuat dan ditampilkan sekali di terminal.
DEMO_USER_PASSWORD=

# Email (notifikasi, mis. pemberitahuan saat email akun diubah Admin).
# "log" = tidak mengirim sungguhan, hanya menulis ke storage/logs/laravel.log. Di server pakai smtp.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@lms.test"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
